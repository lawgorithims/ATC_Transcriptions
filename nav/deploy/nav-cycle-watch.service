[Unit]
Description=Obelisk nav cycle watchdog — alarms when the published AIRAC cycle goes stale
Documentation=file:///opt/obelisk/nav/cycle_watch.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=obelisk
Group=obelisk
EnvironmentFile=/etc/obelisk/nav-watch.env

# ⚠️ THE SITE'S ENV IS SOURCED AT RUN TIME, not copied. systemd's EnvironmentFile cannot include
# another file, and duplicating SMTP credentials into a second place means two things to rotate and
# two things to leak. `set -a` exports what the site file defines so the alerter inherits it.
ExecStart=/bin/bash -c 'set -a; . "$SITE_ENV"; set +a; exec /opt/obelisk/nav/alert_on_stale.sh'

# The check itself needs no credentials and writes nothing but its own state file.
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
StateDirectory=obelisk-nav-watch
# ⚠️ ProtectHome is NOT set: the site's env file often lives under a home directory, and turning
# this on silently hides it, which surfaces as "cannot send mail" long after the install looked fine.

[Install]
WantedBy=multi-user.target
